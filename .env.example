# Copy to .env and fill in. Never commit .env.

# Port published on the Docker host (container listens on 8080)
HOST_PORT=8080

# Optional: require ?token=<value> on every request (strongly recommended if exposed)
ACCESS_TOKEN=

# Optional: live ships (free key from https://aisstream.io)
AISSTREAM_API_KEY=

# Optional: road incidents/closures (https://developer.data.nationalhighways.co.uk)
NATIONAL_HIGHWAYS_KEY=
NATIONAL_HIGHWAYS_KEY_SECONDARY=

# Extra BBC local news feeds (England regions, e.g. gloucestershire,devon,cornwall)
BBC_LOCAL_REGIONS=

# Optional: NASA satellite fire hotspots (free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Optional: live fuel prices from GOV.UK Fuel Finder (register with GOV.UK One Login at
# https://www.developer.fuel-finder.service.gov.uk/access-latest-fuelprices)
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=

# Optional: trains, from the Rail Data Marketplace (https://raildata.org.uk, free). Subscribe to
# "Live Departure Board" and "National Rail Disruptions"; each product's Specification tab shows
# its consumer key. RAIL_STATIONS is your stations' 3-letter codes (default: nearest to home).
RAIL_LDB_KEY=
RAIL_DISRUPTIONS_KEY=
RAIL_STATIONS=

# Optional: buses in England, from the DfT Bus Open Data Service (free): register as a data
# consumer at https://data.bus-data.dft.gov.uk/account/signup/ and copy the API key from your account.
BODS_API_KEY=
# Bus stops and timetables (no key needed): BODS regions to download weekly, e.g. south_west.
# One of north_east, north_west, yorkshire, east_midlands, west_midlands, east_anglia, south_east,
# south_west, london. Each is a ~250 MB download, indexed to ~40 MB in DATA_DIR.
BUS_TIMETABLE_REGIONS=
# Optional: EV chargers from Open Charge Map (free): register at https://openchargemap.org/site/loginprovider/beginlogin,
# then My Profile -> My Apps -> Register an application, and copy the API key.
OCM_API_KEY=

# Optional: your home area, for the "Near home" panel and notifications
HOME_LAT=
HOME_LON=
HOME_NAME=Home
HOME_RADIUS_KM=25
# Optional: Home Assistant webhook for notifications of new nearby events
# (an automation with a webhook trigger; see README)
HA_WEBHOOK_URL=
NOTIFY=warning,flood,river,sewage,fire,road,power,rnli,aircraft,hems,lightning,iss,rail,bus

# Optional: more homes from the same deployment (HOME2_* ... HOME9_*). Each gets its own Near home
# panel and notifications; its token is a second ACCESS_TOKEN that opens the map on that home.
# Unset _NOTIFY falls back to NOTIFY.
HOME2_NAME=
HOME2_LAT=
HOME2_LON=
HOME2_RADIUS_KM=
HOME2_TOKEN=
HOME2_WEBHOOK_URL=
HOME2_RAIL_STATIONS=
HOME2_NOTIFY=

# Live lightning from Blitzortung.org (volunteer network; private, non-commercial use only)
ENABLE_LIGHTNING=true

# Scraped sources — off by default; check the sites' terms before enabling
ENABLE_WORLDCAM=false
ENABLE_DSFRS=false
# Other fire & rescue services' published incident feeds (remove any you don't want)
FIRE_SERVICES=avon,bucks,cheshire,cleveland,hants,rbfrs,shropshire
# DSFRS_STATION_IDS=283,282,281,275,274,277,279,280,278,276
# DSFRS_AREAS=Teignbridge,Torbay

# Poll ADS-B continuously so "air ambulance on scene" works with nobody watching
ENABLE_BACKGROUND_ADSB=true

# Optional: your own curated webcam list (see config/cameras.json for the format)
# CAMERAS_FILE=/config/cameras.json

LOG_LEVEL=INFO
